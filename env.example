# ضع بياناتك هنا - انسخ الملف: cp env.example .env
# api_id و api_hash من https://my.telegram.org -> API development tools
TG_API_ID=PUT_YOUR_API_ID_HERE
TG_API_HASH=PUT_YOUR_API_HASH_HERE

# قنوات/جروبات محددة بالـ id أو اليوزر، مفصولة بفاصلة
# شغّل: py -3 tg_list_folders.py --channels  عشان تشوف القائمة كلها
TG_CHANNELS=

# أسماء الفولدرات بالظبط زي ما هي في تليجرام، مفصولة بفاصلة (اختياري)
TG_FOLDERS=

# الامتدادات اللي عايز تنزّلها مفصولة بفاصلة (مثال: txt,rar,zip)
TG_EXTENSIONS=txt,rar

# مكان التنزيل
OUT_DIR=C:\telegram_downloads\

# أول تشغيل: 0 = كل الأرشيف، أو رقم = آخر كام يوم بس
FIRST_RUN_DAYS=0

# أقصى حجم للملف بالميجا - 0 = بدون حد
MAX_FILE_MB=0

# تقرير لايف على Saved Messages: 1 = شغال، 0 = مقفول
TG_NOTIFY=1

# معاد المزامنة اليومية التلقائية
DAILY_TIME=03:00
